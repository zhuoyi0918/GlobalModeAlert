#!name=代理模式提醒
#!desc=定时检测小火箭是否处于「全局」或「直连」模式并发通知。原理：一个国内接口强制 DIRECT、一个境外接口强制 PROXY，对比两者出口判断当前模式。
#!author=Nellstar
#!homepage=https://github.com/zhuoyi0918

[Rule]
DOMAIN-SUFFIX,ipip.net,DIRECT
DOMAIN,www.cloudflare.com,PROXY

[Script]
代理模式提醒 = type=cron,cronexp="* * * * *",script-path=https://raw.githubusercontent.com/zhuoyi0918/GlobalModeAlert/main/global-mode-alert.js,timeout=20,argument=interval=1&global=1&direct=1&debug=0
